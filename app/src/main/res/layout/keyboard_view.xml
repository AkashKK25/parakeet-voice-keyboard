<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/kb_background"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <!-- Top Status & Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/statusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_mic_idle" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/status_loading"
            android:textColor="@color/kb_text_secondary"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/progressAudioLevel"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="64dp"
            android:layout_height="6dp"
            android:layout_marginEnd="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/kb_accent"
            android:visibility="invisible" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_key"
            android:contentDescription="Settings"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings" />

        <ImageButton
            android:id="@+id/btnSwitchIme"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_key"
            android:contentDescription="Switch keyboard"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_keyboard" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp"
        android:background="@color/kb_divider" />

    <!-- Main Dictation & Editing Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Left Quick Keys -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnComma"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_key"
                    android:text=","
                    android:textColor="@color/kb_text_primary"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/btnPeriod"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_key"
                    android:text="."
                    android:textColor="@color/kb_text_primary"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnUndo"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_key"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_undo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/key_undo"
                    android:textColor="@color/kb_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Center Mic Button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnMic"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/bg_mic_idle"
                android:contentDescription="Dictate"
                android:padding="22dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic" />

            <TextView
                android:id="@+id/tvMicHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Tap or Hold"
                android:textColor="@color/kb_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Right Quick Keys -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnQuestion"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_key"
                    android:text="\?"
                    android:textColor="@color/kb_text_primary"
                    android:textSize="17sp" />

                <ImageButton
                    android:id="@+id/btnBackspace"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_key"
                    android:contentDescription="Backspace"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_backspace" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnEnter"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_key"
                android:contentDescription="Enter"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_enter" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Spacebar Row -->
    <Button
        android:id="@+id/btnSpace"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_key"
        android:text="@string/key_space"
        android:textAllCaps="false"
        android:textColor="@color/kb_text_secondary"
        android:textSize="13sp" />

</LinearLayout>
